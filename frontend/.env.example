# URL base da API usada pelo front. Padrão: /api (proxy do Vite em dev).
# Em produção aponte para o backend publicado, ex: https://api.agrostand.com/api
# VITE_API_URL=http://localhost:3000/api

# Alvo do proxy do Vite em dev (padrão: http://localhost:3000)
# VITE_BACKEND_URL=http://localhost:3000

# Client ID OAuth do Google (público) para o botão "Entrar com Google".
# Deve ser o mesmo GOOGLE_CLIENT_ID do backend.
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
