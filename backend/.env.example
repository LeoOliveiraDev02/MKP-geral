PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# RN19: bloqueio temporário após N falhas consecutivas de login
LOGIN_MAX_ATTEMPTS=3
LOGIN_BLOCK_MINUTES=15

# PostgreSQL via Drizzle ORM (node-postgres) com Row-Level Security.
# DATABASE_URL: role da API (sem superuser/BYPASSRLS) — criado/atualizado no boot.
# DATABASE_ADMIN_URL: dono das tabelas; usado só no boot (DDL, policies, grants, seed).
DATABASE_URL=postgres://agrostand_app:troque_esta_senha@localhost:5432/agrostand
DATABASE_ADMIN_URL=postgres://postgres:senha_do_admin@localhost:5432/agrostand

# SMTP Configuration for Password Recovery
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@agrostand.com

# Login com Google (Google Identity Services) — console.cloud.google.com > APIs e serviços > Credenciais
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Marketplace (ambiente de teste)
# Geocodificação de endereços para "perto de mim" e mapa (Nominatim/OpenStreetMap, 1 req/s)
GEOCODER=nominatim
# E-mails com acesso de administrador (verificação de produtores e mediação), separados por vírgula
ADMIN_EMAILS=admin.demo@agrostand.com
# URL pública do front (links em e-mails e na prévia de compartilhamento)
FRONTEND_URL=http://localhost:5173
# Envia também por e-mail as notificações do site (on/off). Sem SMTP, usa Ethereal ou o console.
NOTIFY_EMAIL=on

# ─── Segurança (ver SECURITY.md) ────────────────────────────────────────────
# Em produção (NODE_ENV=production) o servidor NÃO sobe se faltar algo crítico.
# JWT_SECRET: >= 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# Origens do front liberadas no CORS (separadas por vírgula). Obrigatório em produção.
CORS_ORIGINS=http://localhost:5173
# Proxies na frente da API (Cloudflare + Render = 2). Padrão em produção: 1.
TRUST_PROXY=
# Cookie de sessão: strict (front e API no mesmo site) | lax | none (sites diferentes; exige HTTPS)
COOKIE_SAMESITE=strict
# Domínio do cookie quando front e API estão em subdomínios (ex: .agromundo.com.br)
COOKIE_DOMAIN=

# Rate limit por IP (requisições por janela)
RATE_LIMIT_API=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_ESCRITA=30
# Custo do bcrypt (padrão 12)
BCRYPT_ROUNDS=12

# MFA (TOTP): chave que cifra os segredos dos autenticadores (>= 32 caracteres). Obrigatória em produção.
MFA_ENCRYPTION_KEY=
# Fora de produção dá para desligar a exigência de MFA no admin: ADMIN_MFA=off
ADMIN_MFA=

# Pagamentos: segredo HMAC do webhook do gateway (X-Webhook-Signature)
PAYMENT_WEBHOOK_SECRET=
# Botão "pagar" do comprador (simulação). Ignorado em produção (sempre off).
PAGAMENTO_SIMULADO=on

# Tarefas agendadas (POST /api/ads/cleanup exige o cabeçalho X-Cron-Secret)
CRON_SECRET=

# Backups (npm run db:backup / npm run db:backup:test)
BACKUP_DIR=./backups
BACKUP_RETENTION=14
# Cifra os arquivos de backup (guarde esta chave fora do servidor do banco)
BACKUP_ENCRYPTION_KEY=

# ─── Senhas e sessões ───
# Segredo extra do hash de senha (obrigatório em produção, ≥ 32 caracteres).
# NUNCA troque depois de definido: as senhas gravadas com ele deixam de conferir.
PASSWORD_PEPPER=
# Minutos sem uso até a sessão cair (padrão 480 = 8 h). Timeout absoluto: 24 h.
SESSION_IDLE_MINUTES=480
# Recusa senhas que aparecem em vazamentos (Have I Been Pwned, k-anonymity). on/off
PASSWORD_BREACH_CHECK=on
# Alertas de segurança por e-mail (troca de senha/e-mail, MFA, aparelho novo). on/off
SECURITY_EMAIL=on

# URL pública da API (redirect HTTP→HTTPS com host fixo, security.txt)
API_PUBLIC_URL=
# Contato para relatos de vulnerabilidade (/.well-known/security.txt)
SECURITY_CONTACT=mailto:seguranca@agromundo.com.br

# Banco: limites de conexão e tempo máximo de cada consulta (ms).
# Banco fora da rede privada? acrescente ?sslmode=require na DATABASE_URL.
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
